{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quadrant",
  "version": "3.0.0",
  "identifier": "com.sonofg0tham.quadrant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quadrant",
        "width": 1280,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0f151a",
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
